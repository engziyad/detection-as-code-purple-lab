``` Suspicious Service Installation (PsExec-style / Command Services) | c36a647e-caeb-4c7d-894f-8b5a3619a350 ```
index=wineventlog source="XmlWinEventLog:System"
| where ((lower('Provider_Name')="service control manager" AND 'EventCode'=7045) AND ((match('ImagePath', "(?i)%COMSPEC%") OR match('ImagePath', "(?i)cmd\\.exe\\ /c") OR match('ImagePath', "(?i)cmd\\ /c") OR match('ImagePath', "(?i)cmd\\.exe\\ /Q\\ /c") OR match('ImagePath', "(?i)powershell") OR match('ImagePath', "(?i)\\\\ADMIN\\$\\\\") OR match('ImagePath', "(?i)\\\\\\\\127\\.0\\.0\\.1\\\\") OR match('ImagePath', "(?i)\\\\AppData\\\\") OR match('ImagePath', "(?i)\\\\Users\\\\Public\\\\") OR match('ImagePath', "(?i)\\\\Windows\\\\Temp\\\\") OR match('ImagePath', "(?i)\\.bat")) OR (match('ServiceName', "(?i)^PSEXESVC") OR match('ServiceName', "(?i)^BTOBTO")) OR match('ImagePath', "(?i)^%?SystemRoot%?\\\\[A-Za-z]{8}\\.exe$")))
