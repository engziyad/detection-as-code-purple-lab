``` Windows Event Log Clearing via Command Line | c62bd792-3b92-4bad-819c-fa3c123151d2 ```
index=sysmon source="XmlWinEventLog:Microsoft-Windows-Sysmon/Operational" EventCode=1
| where ((match('Image', "(?i)\\\\wevtutil\\.exe$") AND (match('CommandLine', "(?i)\\ cl\\ ") OR match('CommandLine', "(?i)\\ clear\\-log\\ "))) OR ((match('Image', "(?i)\\\\powershell\\.exe$") OR match('Image', "(?i)\\\\pwsh\\.exe$")) AND (match('CommandLine', "(?i)Clear\\-EventLog") OR match('CommandLine', "(?i)Remove\\-EventLog") OR match('CommandLine', "(?i)Limit\\-EventLog") OR match('CommandLine', "(?i)\\.ClearLog\\(") OR match('CommandLine', "(?i)Clear\\-WinEvent"))) OR (match('Image', "(?i)\\\\wmic\\.exe$") AND (match('CommandLine', "(?i)nteventlog") AND match('CommandLine', "(?i)cleareventlog"))))
