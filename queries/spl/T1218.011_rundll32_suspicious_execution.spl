| where ((match('Image', "(?i)\\\\rundll32\\.exe$") OR lower('OriginalFileName')="rundll32.exe") AND ((match('CommandLine', "(?i)javascript:") OR match('CommandLine', "(?i)vbscript:") OR match('CommandLine', "(?i)RunHTMLApplication")) OR (match('CommandLine', "(?i)\\\\AppData\\\\Local\\\\Temp\\\\") OR match('CommandLine', "(?i)\\\\AppData\\\\Roaming\\\\") OR match('CommandLine', "(?i)\\\\Users\\\\Public\\\\") OR match('CommandLine', "(?i)\\\\ProgramData\\\\") OR match('CommandLine', "(?i)\\\\Windows\\\\Temp\\\\") OR match('CommandLine', "(?i)\\\\Downloads\\\\")) OR (match('CommandLine', "(?i)comsvcs") AND match('CommandLine', "(?i)minidump")) OR match('CommandLine', "(?i)rundll32(\\.exe)?\"?\\s*$")))
