``` Kerberoasting - RC4 Service Ticket Requested for User Account | 2847ae87-e869-4b37-811b-e7f0da4f9b0b ```
index=wineventlog source="XmlWinEventLog:Security"
| where (('EventCode'=4769 AND lower('TicketEncryptionType')="0x17" AND lower('Status')="0x0") AND NOT (match('ServiceName', "(?i)\\$$") OR lower('ServiceName')="krbtgt" OR lower('IpAddress')="::1"))
