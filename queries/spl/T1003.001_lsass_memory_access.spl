``` Suspicious Process Access to LSASS Memory | 2a0b1b0e-af2b-4426-a58b-72866042c48c ```
index=sysmon source="XmlWinEventLog:Microsoft-Windows-Sysmon/Operational" EventCode=10
| where ((match('TargetImage', "(?i)\\\\lsass\\.exe$") AND (lower('GrantedAccess')="0x1010" OR lower('GrantedAccess')="0x1410" OR lower('GrantedAccess')="0x1438" OR lower('GrantedAccess')="0x143a" OR lower('GrantedAccess')="0x1fffff")) AND (NOT ((match('SourceImage', "(?i)^C:\\\\Windows\\\\System32\\\\") OR match('SourceImage', "(?i)^C:\\\\Windows\\\\SysWOW64\\\\")) OR (match('SourceImage', "(?i)^C:\\\\ProgramData\\\\Microsoft\\\\Windows\\ Defender\\\\Platform\\\\") AND match('SourceImage', "(?i)\\\\MsMpEng\\.exe$"))) OR (match('SourceImage', "(?i)\\\\rundll32\\.exe$") OR match('SourceImage', "(?i)\\\\taskmgr\\.exe$"))))
