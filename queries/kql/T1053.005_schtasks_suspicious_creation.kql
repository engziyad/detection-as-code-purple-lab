// Scheduled Task Created With Suspicious Action | 2114b226-991c-4830-9b80-8f5421283af3
Sysmon
| where EventID == 1
| where ((Image endswith @"\schtasks.exe" and CommandLine contains @"/create") and ((CommandLine contains @"\AppData\" or CommandLine contains @"\Users\Public\" or CommandLine contains @"\ProgramData\" or CommandLine contains @"\Windows\Temp\" or CommandLine contains @"%TEMP%" or CommandLine contains @"%APPDATA%" or CommandLine contains @"powershell" or CommandLine contains @"cmd /c" or CommandLine contains @"cmd.exe /c" or CommandLine contains @"mshta" or CommandLine contains @"wscript" or CommandLine contains @"cscript" or CommandLine contains @"regsvr32" or CommandLine contains @"http://" or CommandLine contains @"https://") or (CommandLine contains @"/s " and CommandLine contains @"/ru system")))
